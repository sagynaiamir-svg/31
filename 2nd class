<!doctype html>
<html lang="kk">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Компьютерлер қалай үйренеді? — ойын</title>
<style>
:root{--bg:#eef7ff;--card:#fff;--ink:#18324b;--accent:#2f7df6;--ok:#1f9d55;--bad:#d64545;--soft:#dfeeff}
*{box-sizing:border-box}body{margin:0;font-family:Arial,Helvetica,sans-serif;background:linear-gradient(135deg,#eef7ff,#f8f4ff);color:var(--ink);min-height:100vh}
.wrap{max-width:920px;margin:0 auto;padding:24px}.hero{text-align:center;margin:8px 0 18px}.hero h1{font-size:clamp(28px,5vw,48px);margin:0 0 8px}.hero p{font-size:20px;margin:0;color:#4e6780}
.card{background:var(--card);border-radius:24px;padding:28px;box-shadow:0 14px 40px rgba(45,85,125,.14);border:1px solid #dce8f5}.progress{height:14px;background:#e8eef5;border-radius:99px;overflow:hidden;margin-bottom:20px}.bar{height:100%;width:0;background:linear-gradient(90deg,#2f7df6,#6e5cff);transition:.3s}.topline{display:flex;justify-content:space-between;gap:12px;align-items:center;font-weight:700;margin-bottom:12px}.q{font-size:clamp(24px,4vw,36px);font-weight:800;line-height:1.25;margin:12px 0 20px}.answers{display:grid;grid-template-columns:1fr 1fr;gap:14px}.ans{border:3px solid #d8e6f5;background:#f8fbff;border-radius:18px;padding:18px;min-height:86px;font-size:22px;font-weight:700;cursor:pointer;transition:.15s;text-align:left}.ans:hover{transform:translateY(-2px);border-color:#9bc2ff}.ans.correct{background:#e8f8ef;border-color:var(--ok)}.ans.wrong{background:#fff0f0;border-color:var(--bad)}.ans:disabled{cursor:default;transform:none}.feedback{min-height:36px;font-size:22px;font-weight:800;margin:18px 0 8px}.next{display:none;margin-left:auto;border:0;background:var(--accent);color:white;border-radius:16px;padding:14px 22px;font-size:20px;font-weight:800;cursor:pointer}.next.show{display:block}.start,.restart{border:0;background:var(--accent);color:white;border-radius:18px;padding:16px 28px;font-size:22px;font-weight:800;cursor:pointer}.center{text-align:center}.emoji{font-size:64px;margin:6px}.result h2{font-size:40px;margin:10px 0}.result p{font-size:24px}.rules{font-size:20px;line-height:1.5;text-align:left;max-width:650px;margin:16px auto 24px}.badge{display:inline-block;background:var(--soft);border-radius:999px;padding:8px 14px;font-weight:800;margin:4px}.hidden{display:none}@media(max-width:650px){.answers{grid-template-columns:1fr}.card{padding:20px}.ans{font-size:20px}}
</style>
</head>
<body>
<div class="wrap">
  <div class="hero"><h1>🤖 Компьютерлер қалай «үйренеді»?</h1><p>2-сыныпқа арналған бекіту ойыны</p></div>

  <section id="start" class="card center">
    <div class="emoji">🧠💻</div>
    <h2>«Ақылды модель» ойыны</h2>
    <div class="rules">
      <b>Ереже:</b> әр сұрақта дұрыс жауапты таңда. Компьютердің мысалдар арқылы қалай «үйренетінін» есіңе түсір. Әр дұрыс жауапқа ⭐ 1 ұпай аласың.
    </div>
    <span class="badge">8 сұрақ</span><span class="badge">⭐ 8 ұпай</span><span class="badge">5–7 минут</span><br><br>
    <button class="start" onclick="beginGame()">Ойынды бастау ▶</button>
  </section>

  <section id="game" class="card hidden">
    <div class="progress"><div id="bar" class="bar"></div></div>
    <div class="topline"><span id="counter">1 / 8</span><span>⭐ <span id="score">0</span></span></div>
    <div id="question" class="q"></div>
    <div id="answers" class="answers"></div>
    <div id="feedback" class="feedback"></div>
    <button id="next" class="next" onclick="nextQuestion()">Келесі ➜</button>
  </section>

  <section id="result" class="card center result hidden">
    <div id="resultEmoji" class="emoji">🏆</div>
    <h2>Ойын аяқталды!</h2>
    <p>Сенің нәтижең: <b><span id="finalScore">0</span> / 8</b> ⭐</p>
    <p id="resultText"></p>
    <button class="restart" onclick="restartGame()">Қайта ойнау ↻</button>
  </section>
</div>
<script>
const questions=[
 {q:'Компьютерге жаңа затты тануды үйрету үшін ең алдымен не береміз?',a:['Көп мысал','Тек бір сөз','Музыка','Пароль'],c:0,ok:'Дұрыс! Компьютер мысалдар арқылы үйренеді.'},
 {q:'Алма мен бананды үйретсек, суреттерді не істеу керек?',a:['Араластырып тастау','Екі топқа бөлу','Өшіру','Жасыру'],c:1,ok:'Жарайсың! Үлгілерді дұрыс топқа бөлеміз.'},
 {q:'Компьютерге тек 1 алма суретін көрсетсек, ол әр алма түрін бірден дұрыс тани ма?',a:['Иә, әрқашан','Жоқ, көбірек мысал керек','Тек түнде таниды','Тек мұғалім болса'],c:1,ok:'Дұрыс! Әртүрлі мысал көп болғаны жақсы.'},
 {q:'Үйреткеннен кейін не істейміз?',a:['Нәтижені тексереміз','Компьютерді жабамыз','Суреттерді жыртамыз','Ештеңе істемейміз'],c:0,ok:'Дұрыс! Модельдің жауабын тексереміз.'},
 {q:'Компьютер қате жауап беруі мүмкін бе?',a:['Иә','Жоқ, ешқашан','Тек сенбіде','Тек интернет жоқта'],c:0,ok:'Дұрыс! Модель де қателесуі мүмкін.'},
 {q:'Модель қате жауап берсе, не істеген дұрыс?',a:['Көбірек дұрыс мысал беру','Компьютерге ұрысу','Барлығын өшіру','Сабақты тоқтату'],c:0,ok:'Өте жақсы! Қосымша мысалдар модельге көмектеседі.'},
 {q:'Қайсысы «мысал» бола алады?',a:['Мысықтың бірнеше суреті','Бос экран','Құпия сөз','Жабық кітап'],c:0,ok:'Дұрыс! Суреттер үйретуге арналған мысал бола алады.'},
 {q:'Компьютер адам сияқты нақты ойлай ма?',a:['Жоқ, ол берілген мысалдар мен ережелерге сүйенеді','Иә, дәл адам сияқты','Ол тек армандайды','Ол бәрін өзі біледі'],c:0,ok:'Керемет! Компьютер адам сияқты ойламайды, ол берілген үлгілерге сүйенеді.'}
];
let idx=0,score=0,locked=false;
function beginGame(){document.getElementById('start').classList.add('hidden');document.getElementById('game').classList.remove('hidden');render();}
function render(){locked=false; const q=questions[idx];document.getElementById('counter').textContent=`${idx+1} / ${questions.length}`;document.getElementById('score').textContent=score;document.getElementById('bar').style.width=`${(idx/questions.length)*100}%`;document.getElementById('question').textContent=q.q;document.getElementById('feedback').textContent='';document.getElementById('next').classList.remove('show');const box=document.getElementById('answers');box.innerHTML='';q.a.forEach((x,i)=>{const b=document.createElement('button');b.className='ans';b.textContent=x;b.onclick=()=>choose(i,b);box.appendChild(b);});}
function choose(i,btn){if(locked)return;locked=true;const q=questions[idx];const buttons=[...document.querySelectorAll('.ans')];buttons.forEach(b=>b.disabled=true);if(i===q.c){score++;btn.classList.add('correct');document.getElementById('feedback').textContent='✅ '+q.ok;}else{btn.classList.add('wrong');buttons[q.c].classList.add('correct');document.getElementById('feedback').textContent='💡 Дұрыс жауап жасыл түспен көрсетілді.';}document.getElementById('score').textContent=score;document.getElementById('next').classList.add('show');}
function nextQuestion(){idx++;if(idx<questions.length){render()}else{finish()}}
function finish(){document.getElementById('bar').style.width='100%';document.getElementById('game').classList.add('hidden');document.getElementById('result').classList.remove('hidden');document.getElementById('finalScore').textContent=score;let t='',e='🏆';if(score===8){t='Керемет! Сен тақырыпты өте жақсы меңгердің!';e='🏆'}else if(score>=6){t='Өте жақсы! Аз ғана қайталау жеткілікті.';e='🌟'}else if(score>=4){t='Жақсы! Тағы бір рет ойнап, біліміңді бекіт.';e='👍'}else{t='Тақырыпты тағы бір қарап шығып, қайта ойнап көр.';e='💪'}document.getElementById('resultText').textContent=t;document.getElementById('resultEmoji').textContent=e;}
function restartGame(){idx=0;score=0;document.getElementById('result').classList.add('hidden');document.getElementById('game').classList.remove('hidden');render();}
</script>
</body>
</html>
